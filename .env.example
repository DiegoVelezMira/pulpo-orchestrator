CLAUDE_API_KEY=sk-ant-tu-clave-aqui
DATABASE_PATH=./pulpo.db
PORT=3000

# Bloque 1 (Gmail): credenciales OAuth de un proyecto en Google Cloud Console.
# GOOGLE_REDIRECT_URI debe ser exactamente la URL pública de Pulpo + /gmail/oauth/callback
# y estar registrada como "Authorized redirect URI" en ese mismo proyecto de Google Cloud.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=https://tu-dominio-de-pulpo/gmail/oauth/callback
