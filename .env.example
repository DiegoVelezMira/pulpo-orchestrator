CLAUDE_API_KEY=sk-ant-tu-clave-aqui
DATABASE_PATH=./pulpo.db
PORT=3000

# Bloque 1 (Gmail): credenciales OAuth de un proyecto en Google Cloud Console.
# GOOGLE_REDIRECT_URI debe ser exactamente la URL pública de Pulpo + /gmail/oauth/callback
# y estar registrada como "Authorized redirect URI" en ese mismo proyecto de Google Cloud.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=https://tu-dominio-de-pulpo/gmail/oauth/callback

# Bloque 4 (Aprobaciones): URL pública de Pulpo, solo para armar el link al
# panel dentro del correo de notificación de aprobaciones pendientes.
# Opcional — si no está, el correo se manda igual, sin el link.
PULPO_BASE_URL=https://tu-dominio-de-pulpo

# Acceso (Pulpo v1): cada oficina entra con su clave; el administrador con la suya.
# En producción (PULPO_PUBLIC=1) son obligatorias: sesión de 32+ caracteres y administrador de 16+.
# Genera valores largos y al azar, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULPO_SESSION_SECRET=cambia-esto-por-32-o-mas-caracteres-al-azar
PULPO_ADMIN_KEY=cambia-esto-por-una-clave-larga
# Minutos de bloqueo tras 3 claves incorrectas (por oficina y dirección de red). Por defecto 15.
PULPO_BLOQUEO_MIN=15
# PULPO_PUBLIC=1   # actívalo cuando Pulpo se publique por túnel o hosting (cookies Secure y variables obligatorias)

# Lectura de PDF: modelo que lee el texto de las facturas (por defecto claude-haiku-5-5) y llave de la API.
# El tope mensual de PDF leídos con IA se fija por oficina: PUT /api/admin/oficinas/:id/tope {"tope": 400}
# ANTHROPIC_API_KEY=   # la llave va aquí, en el servidor; nunca en el código ni en el chat
# PULPO_MODELO_LECTOR=claude-haiku-5-5
